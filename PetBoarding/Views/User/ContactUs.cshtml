@model PetBoarding.ViewModels.ContactFormVM

@{
    ViewBag.Title = "Contact Us";
    Layout = "~/Views/User/_UserLayout.cshtml";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title</h2>
    <h3>@ViewBag.Message</h3>

    <h4>@Model.ContactForm.Subject</h4>
    <h6>Responded: @Model.ContactForm.Responded</h6>
    <p>@Model.ContactForm.Body</p>

    <div class="col-md-8">
        <section id="contactSubmissionForm">
            @using (Html.BeginForm("ContactUs", "User", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                <h4>Submit a contact form.</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="row">
                    @Html.LabelFor(m => m.ContactForm.Subject, new { @class = "col-md-2 col-form-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.ContactForm.Subject, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ContactForm.Subject, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    @Html.LabelFor(m => m.ContactForm.Body, new { @class = "col-md-2 col-form-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.ContactForm.Body, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ContactForm.Body, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    <div class="offset-md-2 col-md-10">
                        <input type="submit" value="Submit" class="btn btn-outline-dark" />
                    </div>
                </div>
            }
        </section>
    </div>
</main>