@model PetBoarding.ViewModels.ManagePetsVM

@{
    ViewBag.Title = "Manage Pets";
    Layout = "~/Views/User/_UserLayout.cshtml";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title</h2>
    <h3>@ViewBag.Message</h3>

    <h4>Your Pets:</h4>
    @foreach (var pet in Model.Pets)
    {
        <div key=pet.PetId class='pet-info-box'>
            <h5>@pet.Name</h5>
            <p>Breed: @pet.Breed</p>
            <p>Age: @pet.Age years</p>
            <p>Emergency Contact: @pet.EmergencyContact.Name, @pet.EmergencyContact.PhoneNumber</p>
            <h6>Special Instructions:</h6>
            <p> @pet.SpecialInstructions</p>
            <div class="row">
                <div class="col-md-10">
                    @* <input type="submit" value="Update" class="btn btn-outline-dark" /> *@
                    <section id="AddPetForm">
                        @using (Html.BeginForm("DeletePet", "User", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post,
                        new { onsubmit = "return confirm('Are you sure you want to delete this pet?');", role = "form" }
                        ))
                        {
                            <input type="hidden" name="id" value="@pet.PetId" />
                            <input type="submit" value="Delete" class="btn btn-outline-dark" />
                        }
                    </section>
                </div>
            </div>
        </div>
    }

    <div class="col-md-8">
        <section id="AddPetForm">
            @using (Html.BeginForm("AddPet", "User", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new
            {
                role
            = "form"
            }))
            {
                @Html.AntiForgeryToken()
                <h4>Add a Pet:</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="row">
                    @Html.LabelFor(m => m.Pet.Name, new { @class = "col-md-2 col-form-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.Pet.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Pet.Name, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    @Html.LabelFor(m => m.Pet.Breed, new { @class = "col-md-2 col-form-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.Pet.Breed, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Pet.Breed, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    @Html.LabelFor(m => m.Pet.Age, new { @class = "col-md-2 col-form-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.Pet.Age, new { @class = "form-control", type = "number" })
                        @Html.ValidationMessageFor(m => m.Pet.Age, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    @Html.LabelFor(m => m.Pet.SpecialInstructions, new { @class = "col-md-2 col-form-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.Pet.SpecialInstructions, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Pet.SpecialInstructions, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    @Html.LabelFor(m => m.Pet.EmergencyContact, new { @class = "col-md-2 col-form-label" })
                    <div class="col-md-10">
                        <select name='EmergencyContactId' id='emergency-contact-dropdown'>
                            @foreach (var e in Model.EmergencyContacts)
                            {
                                <option value=@e.EmergencyContactId>@e.Name</option>
                            }
                        </select>
                        @Html.ValidationMessageFor(m => m.Pet.EmergencyContact, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    @Html.LabelFor(m => m.Pet.AnimalType, new { @class = "col-md-2 col-form-label" })
                    <div class="col-md-10">
                        <select name='AnimalType' id='animal-type-dropdown'>
                            @foreach (var e in Model.AnimalTypes)
                            {
                                <option value=@e.AnimalTypeId>@e.Type</option>
                            }
                        </select>
                        @Html.ValidationMessageFor(m => m.Pet.AnimalType, "", new { @class = "text-danger" })
                    </div>
                </div>

                
                <div class="row">
                    <div class="offset-md-2 col-md-10">
                        <input type="submit" value="Submit" class="btn btn-outline-dark" />
                    </div>
                </div>
            }
        </section>
    </div>
</main>